; Plant 01 native visual study. This project is separate from the playable web game.
config_version=5

[application]
config/name="Plant 01 — Native Visual Study"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1680
window/size/viewport_height=945
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/dpi/allow_hidpi=true

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/driver="vulkan"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.65, 0.75, 0.86, 1)

[audio]
driver/enable_input=false
