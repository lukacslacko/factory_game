{
  "version": 1,
  "transport": "127.0.0.1 ephemeral TCP, NDJSON; hello token top-level; request {id,action,args}; reply {type:reply,id,ok,result,error}; snapshot 5Hz {type:snapshot,seq,state,catalog,render,storage}",
  "actions": {
    "hello": "{token} at top level; result version/capabilities then initial snapshot",
    "new_game": "{mode:empty|starter|example}; preserves previous yard as backup",
    "continue": "{}; unpauses loaded state",
    "save": "{path?:absolute}; saves current yard atomically, default native save file",
    "load": "{path?:absolute}; default current native save",
    "import": "{path:absolute} OR {json:string}; validates browser save then loads paused and saves backup",
    "export": "{path?:absolute}; JSON written if path, otherwise returns {json}",
    "restore_backup": "{}; swaps current/backup yard, loaded paused",
    "diagnostics": "{path?:absolute}; writes rolling diagnostic export, otherwise returns archive",
    "shutdown": "{}; save and stop service",
    "purchase_batch": "{lines:[{item:string,qty:int}],mode:road|rail}",
    "purchase": "{item:string,qty:int,mode:road|rail}",
    "purchase_preview": "{lines:[{item,qty}],mode:road|rail}; packing/weight/cost preview",
    "starter_order": "{}",
    "buy_missing": "{}",
    "pause": "{paused?:bool}; toggles if omitted",
    "speed": "{value:1|3|10}; unpauses",
    "guide": "{visible:bool}",
    "plan": "{kind:string,x:number,z:number,rotation?:0|1,foundations?:bool}",
    "pave": "{rect:{x,z,w,d}}",
    "zone": "{rect:{x,z,w,d},name?:string}",
    "remove_zone": "{id:string}",
    "rail_preview": "{layout:straight|curve|turnout,x,z,heading:0..3,hand:1|-1,snap?:bool}; returns origin,heading,hand,layout,error,pieces,geometries",
    "plan_rail": "same as rail_preview; error reply on invalid placement",
    "resume_track": "{id:workId}",
    "turnout": "{id:railId,route:straight|branch}",
    "move_worker": "{id:workerId,x,z}; includes driving boarded equipment",
    "control": "{id:workerId}; manual duty",
    "release": "{id:workerId}; automatic duty",
    "worker_duty": "{id:workerId,duty:auto|rest}",
    "enter_vehicle": "{workerId,equipmentId}",
    "exit_vehicle": "{id:workerId}",
    "unload": "{orderId,workerId}",
    "delivery_pause": "{id:equipmentId}",
    "delivery_resume": "{id:equipmentId}",
    "equipment_role": "{id:equipmentId,role:all|receiving|paving|construction|rail|recovery|hold}",
    "equipment_activities": "{id:equipmentId,activities:[receiving|paving|construction|rail|recovery]}",
    "assistant": "{id:equipmentId,workerId?:string}; omit workerId to clear",
    "worker_schedule": "{id:workerId,startHour:number|null,endHour?:number}",
    "parking": "{id:equipmentId,x,z,rotation:0..3}",
    "clear_parking": "{id:equipmentId}",
    "job_equipment": "{id:workId,equipmentId?:string}; omit equipmentId for auto",
    "rail_crew": "{id:workId,stagingEquipmentId?:string,installingEquipmentId?:string}",
    "assign_worker": "{id:jobId,workerId:string}",
    "priority": "{id:workId}; supports groups",
    "cancel_job": "{id:jobId}",
    "refuel": "{id:equipmentId}",
    "remove_building": "{id:buildingId}",
    "recover": "{x,z}",
    "move_stock": "{id:stackId,x,z} OR {id,rect:{x,z,w,d}}; preserves original panel orientation/footprint",
    "rail_location_anchor": "{x,z}; nearest installed track anchor",
    "save_rail_location": "{location:{id?,name,kind:loading|unloading|transfer|parking,trackId,route,offset,length}}",
    "remove_rail_location": "{id:locationId}",
    "notice": "{id:noticeId,state?:todo|doing|done,seen?:bool}",
    "mark_all_seen": "{}",
    "inspect": "{id}; entity plus type/references/intents",
    "tables": "{table?:string}; native reporting rows",
    "sql": "{sql:string}; SELECT/WITH/EXPLAIN SQLite reporting snapshot",
    "ping": "{}; clock and bounded transport counters",
    "export_costs": "{path:absolute}; writes full cost history CSV",
    "electrical_preview": "{sourceId,targetId,cells:[{x:int,z:int}]}; read-only valid/error, surveyed spoil and lifted-paving reservations, meters and endpoint terminal cells",
    "electrical_plan": "same as electrical_preview; creates real linked cable construction work or commissions instantly in creative",
    "electrical_cancel": "{id:runId|jobId}; request safe cancellation with physical material and soil restoration",
    "electrical_resume": "{id:runId|jobId}; resume safely canceled unfinished circuit",
    "electrical_recover": "{id:runId|jobId}; queue physical isolation, re-excavation, cable retrieval to real available reel capacity, backfill and paving restoration; downstream branches must be recovered first",
    "storage_move_preview": "{id:stackId,quantity?:int,zoneId?:stockyardId,requestId?:string}; read-only physical source/route/space preview: {error,quantity,mass,zoneId,destination,requestId}",
    "move_to_storage": "same as storage_move_preview; reserves source and destination, creates grouped physical lifting work, returns {error,job,groupId,jobIds,requestId}"
  },
  "snapshot": {
    "state": "Existing src/types.ts State JSON; events/movements/costs snapshot tails bounded, complete history retained for saves/SQL",
    "catalog": "{materials,buildings,equipment,roles,services,equipmentRoles,activities,sqlExamples,bounds,gauge}",
    "storage": "{dataDir,savePath,backupPath,lastSavedAt,loadError,hasSave,hasBackup,started}",
    "render": "{actors:[{id,kind,x,z,y,yaw,visible,lift,reach,walking,cargo}],carriers:[{id,kind,x,z,y,yaw,pitch,travel,freight,cargo,ramp}],railGeometry:[{id,geometry,planned}],railNetwork,railWork:[{jobId,equipmentId,panel,buffer,lifting,phase}],construction:[{jobId,equipmentId,item,pose,state,phase}],sheds:[{jobId,parts}],railLocations:[{id,pose,path,status}],equipmentIntents:[{id,...intent}]}; loads:[{id,item,qty,pose,parentEquipmentId,carried}], actor toolLift/toolReach/upperYaw/cargoPose/workPhase/workClock",
    "workRows": "jobRows(state), includes hierarchical work orders",
    "inventory": "[{item,...Sim.totals(state,item)}]",
    "summaries": "{totalCosts,costCount,eventCount,movementCount}; full histories, independent of display-tail limits"
  }
}
