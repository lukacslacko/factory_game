{
  "name": "plant-01-starter-yard",
  "version": "0.19.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --max-old-space-size=384 --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run test && npm run build",
    "start": "node server.mjs",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src tests docs *.json *.html *.mjs",
    "generate:example": "node --import tsx tests/create-example.ts",
    "native:build": "tsc --noEmit -p native-runtime/tsconfig.json && node native-runtime/build.mjs",
    "native:service": "node --max-old-space-size=384 native/runtime/service.cjs",
    "native:test": "node --max-old-space-size=384 --import tsx --test --test-concurrency=1 tests/native-runtime.test.ts",
    "native:fixtures": "node --max-old-space-size=384 --import tsx native-runtime/create-visual-fixtures.ts"
  },
  "dependencies": {
    "sql.js": "^1.14.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "esbuild": "^0.28.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukacslacko/factory_game.git"
  }
}
